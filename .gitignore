node_modules/
dist/
dist-uncensored/
dist-demo/
dist-share/
# The uncensored edition's files (src/edition/types.ts): its own repository, never this one
adult/
*.log

# Krea Studio client: cached session cookie and optional local credentials (never commit)
.krea/
.env.krea
.env.sketchfab
# Jev (Typesafe) API key for scripts/model/pickModel.mjs
.env.jev
# Generated ad candidates awaiting review (approved ones move to assets/ads/source/)
assets/ads/pending/
# Generated music awaiting review (scripts/radio/generate.py; approved tracks move to assets/radio/<station>/)
assets/radio_pending/
# Shots, logs and their folders; the scripts that take them are kept
debug-shots/*
!debug-shots/*.mjs
!debug-shots/*.py
# Other agents' checkouts (scripts/worktree.mjs), and this machine's Claude Code settings
.claude/worktrees/
.claude/settings.local.json
.claude/*.lock

# Packs fetched from elsewhere, as downloaded (what's cut from them is in assets/, credited in CREDITS.md)
.cache/

# Reference photos to look at (refs/README.md): never committed, never shipped
refs/*
!refs/README.md

# Python bytecode (scripts/blender)
__pycache__/

# claude-model-guard decision log (contains prompt text)
.claude/model-guard.log.jsonl*
.play-profile/
release/
